# ── DATABASE CONFIGURATION (Prisma)
# URL koneksi utama ke database (misal: PostgreSQL / MySQL)
DATABASE_URL="postgresql://user:password@localhost:5432/trackly_db?schema=public"
# URL koneksi langsung ke database (diperlukan jika menggunakan pooling seperti Supabase)
DIRECT_URL="postgresql://user:password@localhost:5432/trackly_db?schema=public"

# ── SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# ── SECURITY & AUTHENTICATION
# Kunci rahasia bebas acak untuk menandatangani token JWT
JWT_SECRET="ganti_dengan_string_rahasia_yang_sangat_panjang_dan_aman"

# ── THIRD-PARTY INTEGRATIONS
# Google OAuth (Passport Google Strategy)
GOOGLE_CLIENT_ID="://googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# Resend Mailer (Fitur Reset Password Email)
RESEND_API_KEY="re_123456789_abcdefg"

# ── CLIENT CONFIGURATION
# Alamat URL aplikasi front-end (React/Vite)
CLIENT_URL="http://localhost:5173"
