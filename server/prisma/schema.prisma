generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String     @id @default(uuid())
  name              String
  email             String     @unique
  // Legacy password/reset columns are kept only for rollback safety.
  // The app now authenticates with Google OAuth or a one-time email code.
  password          String?
  createdAt         DateTime   @default(now())
  googleId          String?    @unique
  resetToken        String?    @unique
  resetTokenExpiry  DateTime?
  // True once the email has been proven through OTP or a verified Google email.
  emailVerified     Boolean    @default(false)
  categories        Category[]
  entries           Entry[]
  notifications     Notification[]
  subscriptions     PushSubscription[]
  oauthCodes        OAuthCode[]
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  name      String
  unit      String
  color     String
  icon      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   Entry[]

  @@unique([userId, name])
  @@index([userId])
}

model Entry {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  date       DateTime
  value      Float
  note       String?
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([categoryId])
}

model Feedback {
  id        String   @id @default(cuid())
  category  String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // "reminder" | "streak" | dst
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A short-lived, single-use login code sent to an email address.
// The raw code is never stored; only its HMAC hash is kept.
model LoginCode {
  id        String   @id @default(uuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  // Refreshed on resend; it doubles as the 60-second cooldown timer.
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// A short-lived, single-use code used to hand the Google OAuth result back to
// the SPA without putting a 7-day JWT in the browser URL.
model OAuthCode {
  id        String   @id @default(uuid())
  codeHash  String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}