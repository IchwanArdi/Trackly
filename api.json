              "raw": "{{baseUrl}}/api/entries?categoryId={{categoryId}}&from=2026-01-01&to=2026-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "entries"],
              "query": [
                {
                  "key": "categoryId",
                  "value": "{{categoryId}}",
                  "disabled": true
                },
                {
                  "key": "from",
                  "value": "2026-01-01",
                  "disabled": true
                },
                {
                  "key": "to",
                  "value": "2026-12-31",
                  "disabled": true
                }
              ]
            }
          }
        },
