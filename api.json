            "url": {
              "raw": "{{baseUrl}}/api/reset-password/reset-password/:token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reset-password", "reset-password", ":token"],
              "variable": [
                {
                  "key": "token",
                  "value": "PASTE_RESET_TOKEN_HERE"
                }
              ]
            }
          }
        }
