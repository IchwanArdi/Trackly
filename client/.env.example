# API Backend Base URL
VITE_API_URL=http://localhost:5000

# Public site origin used for canonical URLs, Open Graph, and JSON-LD
VITE_SITE_URL=https://tracklyid.vercel.app

# GA4 Measurement ID (leave empty to disable analytics)
VITE_GA_MEASUREMENT_ID=

# Web Push public key (optional; required only for reminder notifications)
VITE_VAPID_PUBLIC_KEY=
